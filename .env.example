# Plantilla de Variables de Entorno - ViTour Coquimbo
# Copia este archivo como '.env' y completa con tus credenciales:
# cp .env.example .env

# Clave secreta de Django (en producción en AWS EC2, genera una clave segura y única)
SECRET_KEY=tu-clave-secreta-aqui-django-insecure-prod

# Modo depuración (True en local, False en producción AWS EC2)
DEBUG=True

# Hosts permitidos separados por comas (ejemplo local: localhost,127.0.0.1; en EC2: ip-publica,tudominio.com)
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Configuración de Base de Datos MySQL
# Local: WAMP / XAMPP suele usar root sin password o con password local
# AWS EC2 / RDS: Cambiar por los datos del endpoint RDS o MySQL en EC2
DB_NAME=turismo_serena_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
